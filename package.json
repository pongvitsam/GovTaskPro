{
  "name": "govtaskpro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build && node scripts/sync-docs.mjs",
    "build:gas": "vite build --mode gas && node scripts/build-gas.mjs",
    "preview": "vite preview",
    "push": "npx @google/clasp push -f",
    "deploy": "npm run build:gas && npx @google/clasp push -f && node scripts/deploy.mjs",
    "deploy:gas": "npm run deploy",
    "deploy:only": "node scripts/deploy.mjs",
    "login:gas": "npx @google/clasp login"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.0",
    "@tailwindcss/vite": "^4.1.11",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.0.4",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
